        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 1rem;
        }

        .modal-title {
            font-family: var(--font-serif);
            font-size: 1.25rem;
            font-weight: 700;
        }

        .close-btn {
            background: none;
            border: none;
            font-size: 1.5rem;
            color: var(--text-muted);
            padding: 0;
            line-height: 1;
        }

        .lab-input-group {
            margin-bottom: 1.25rem;
        }

        .lab-input-group label {
            display: block;
            margin-bottom: 0.5rem;
